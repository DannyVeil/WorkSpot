# ── Сервер ──────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=4000
# Через сколько дней считать бронь завершённой (не используется как TTL, только для DTO)
TRUST_PROXY=1

# ── Базы данных ─────────────────────────────────────────────────────────
MONGO_URI=mongodb://127.0.0.1:27017/workspot
REDIS_URL=redis://127.0.0.1:6379

# ── Безопасность ────────────────────────────────────────────────────────
# ОБЯЗАТЕЛЬНО замените в production: openssl rand -hex 48
JWT_SECRET=dev-only-workspot-secret-change-me
JWT_ACCESS_TTL=2h
REFRESH_TTL_DAYS=30

# Список origin'ов фронтенда через запятую. Пустое значение = разрешить все (только для разработки)
CORS_ORIGINS=http://localhost:5173,http://localhost:3000,http://127.0.0.1:5173

# ── Правила бронирования ────────────────────────────────────────────────
# Сколько секунд стол удерживается за пользователем, пока он оформляет бронь
HOLD_TTL_SECONDS=600
# Максимальная длительность одной брони, часы
MAX_BOOKING_HOURS=12
# На сколько дней вперёд можно бронировать
BOOKING_HORIZON_DAYS=60
# Часовой пояс коворкинга — используется для проверок «не в прошлом»
BUSINESS_TIMEZONE=Asia/Almaty
